<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="TP_Ing_Soft"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=TP_Ing_Soft;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<add key="Correo.Host" value="smtp.gmail.com" />
		<add key="Correo.Puerto" value="587" />
		<add key="Correo.UsarSsl" value="true" />
		<add key="Correo.Usuario" value="horizon.hotelresorts@gmail.com" />
		<add key="Correo.Clave" value="zajolcinrmuvcabh" />
		<add key="Correo.Remitente" value="horizon.hotelresorts@gmail.com" />
		<add key="Correo.NombreRemitente" value="Horizon Hotel &amp; Resort" />
	</appSettings>
</configuration>